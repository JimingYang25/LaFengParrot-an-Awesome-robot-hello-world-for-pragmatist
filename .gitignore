# Training output is about 1 GB. Keep only the currently verified policy and
# its observation normalizer; checkpoints and TensorBoard logs are reproducible.
rl/runs/*
!rl/runs/gait_ppo_v3_valid/
rl/runs/gait_ppo_v3_valid/*
!rl/runs/gait_ppo_v3_valid/gait_ppo_final.zip
!rl/runs/gait_ppo_v3_valid/vecnormalize.pkl

# These large vector drawings are generated by CAD/source/assembly/make_drawings.py.
# The smaller PNG previews and PDF drawing pack remain versioned.
CAD/drawings/*.svg
