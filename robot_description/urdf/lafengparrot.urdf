<?xml version="1.0"?>
<robot name="lafengparrot">

  <!-- ============================================================
       LaFengParrot REV-B 2026-09-27, generated by make_urdf.py
       single source: kinematics.json + inertials.json
       frame: +X forward(beak), +Y parrot-left, +Z up; origin = hip plane z=0
       units: m / kg / kg*m^2 / rad / N*m / rad/s
       ============================================================ -->

  <!--
       FLOATING BASE CONVENTION:
       The root link "base_link" (CAD segment "trunk") has NO parent joint.
       This is the standard floating-base URDF:
         * PyBullet: p.loadURDF(..., useFixedBase=False) gives the 6-DOF
           free base (3 pos + 3 rot) automatically.
         * ROS: a world -> base_link floating (virtual 6-DOF) joint is
           added by the loader; URDF itself has no world joint.
  -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/trunk.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/collision/trunk_col.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.001038 -0.006302 0.054028" rpy="0 0 0"/>
      <mass value="0.9248"/>
      <inertia ixx="0.001816009" ixy="-1.1491e-05" ixz="6.6285e-05" iyy="0.001863494" iyz="6.0741e-05" izz="0.001415911"/>
    </inertial>
  </link>

